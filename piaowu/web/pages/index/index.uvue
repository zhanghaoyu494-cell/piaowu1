<template>
	<view class="main-layout">
		<!-- 左侧侧边栏 -->
		<view class="sidebar">
			<view class="sidebar-header">
				<image class="logo" src="/static/PixPin_2026-01-13_19-52-32.png"></image>
				<text class="app-title">客服系统</text>
			</view>
			
			<scroll-view class="menu-scroll" scroll-y="true">
				<!-- 管理员菜单 -->
				<view v-if="isAdmin">
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'dashboard' }"
							@click="switchTab('dashboard')"
						>
							<text class="menu-icon">📊</text>
							<text class="menu-text">工作台</text>
						</view>
					</view>

					<view class="menu-group-title">排班管理</view>
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'schedule' }"
							@click="switchTab('schedule')"
						>
							<text class="menu-icon">📅</text>
							<text class="menu-text">排班管理</text>
						</view>
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'shift' }"
							@click="switchTab('shift')"
						>
							<text class="menu-icon">⚙️</text>
							<text class="menu-text">班次配置</text>
						</view>
					</view>

					<view class="menu-group-title">审批中心</view>
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'leave_approve' }"
							@click="switchTab('leave_approve')"
						>
							<text class="menu-icon">✅</text>
							<text class="menu-text">请假审批</text>
						</view>
					</view>

					<view class="menu-group-title">客户服务</view>
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'transfer' }"
							@click="switchTab('transfer')"
						>
							<text class="menu-icon">💬</text>
							<text class="menu-text">会话管理</text>
						</view>
					</view>
				</view>

				<!-- 经理菜单 -->
				<view v-if="isManager">
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'schedule' }"
							@click="switchTab('schedule')"
						>
							<text class="menu-icon">📅</text>
							<text class="menu-text">排班总览</text>
						</view>
					</view>

					<view class="menu-group-title">审批中心</view>
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'leave_approve' }"
							@click="switchTab('leave_approve')"
						>
							<text class="menu-icon">✅</text>
							<text class="menu-text">请假审批</text>
						</view>
					</view>
				</view>

				<!-- 客服菜单 -->
				<view v-if="isCS">
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'schedule' }"
							@click="switchTab('schedule')"
						>
							<text class="menu-icon">📅</text>
							<text class="menu-text">我的排班</text>
						</view>
					</view>

					<view class="menu-group-title">申请管理</view>
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'leave_apply' }"
							@click="switchTab('leave_apply')"
						>
							<text class="menu-icon">✈️</text>
							<text class="menu-text">请假申请</text>
						</view>
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'my_applications' }"
							@click="switchTab('my_applications')"
						>
							<text class="menu-icon">📝</text>
							<text class="menu-text">我的申请</text>
						</view>
					</view>

					<view class="menu-group-title">客户服务</view>
					<view class="menu-group">
						<view 
							class="menu-item" 
							:class="{ active: currentTab === 'transfer' }"
							@click="switchTab('transfer')"
						>
							<text class="menu-icon">💬</text>
							<text class="menu-text">会话管理</text>
						</view>
					</view>
				</view>

				<!-- 用户菜单 -->
				<view v-if="isUser">
					<view class="menu-group">
						<view
							class="menu-item"
							:class="{ active: currentTab === 'user_chat' }"
							@click="switchTab('user_chat')"
						>
							<text class="menu-icon">💬</text>
							<text class="menu-text">客服聊天</text>
						</view>
					</view>
				</view>
			</scroll-view>
			
			<view class="sidebar-footer">
				<view class="user-info">
					<view class="avatar">{{ userAvatar }}</view>
					<view class="user-detail">
						<text class="username">{{ userName }}</text>
						<text class="role-name">{{ roleName }}</text>
					</view>
				</view>
				<view class="logout-btn" @click="handleLogout">
					<text class="logout-icon">🚪</text>
					<text class="logout-text">退出</text>
				</view>
			</view>
		</view>

		<!-- 右侧内容区域 -->
		<view class="content-area">
			<!-- 顶部导航栏 (可选，用于显示当前路径或面包屑) -->
			<view class="top-bar">
				<text class="page-title">{{ currentPageTitle }}</text>
				<view class="top-actions">
					<text class="date-display">{{ currentDate }}</text>
				</view>
			</view>

			<!-- 内容视图容器 -->
			<scroll-view class="view-scroll" scroll-y="true" :scroll-top="scrollTop" @scroll="onViewScroll">
				<view class="view-container">
					<DashboardView v-if="currentTab === 'dashboard'" @navigate="switchTab" />
					<ScheduleView v-if="currentTab === 'schedule'" />
					<ShiftConfigView v-if="currentTab === 'shift'" @request-scroll-top="scrollToTop" />
					<LeaveApplyView v-if="currentTab === 'leave_apply'" />
					<LeaveApproveView v-if="currentTab === 'leave_approve'" />
					<MyApplicationsView v-if="currentTab === 'my_applications'" />
					<TransferView v-if="currentTab === 'transfer'" />
					<UserChatView v-if="currentTab === 'user_chat'" />
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script>
	import DashboardView from '../../components/views/DashboardView.uvue'
	import ScheduleView from '../../components/views/ScheduleView.uvue'
	import ShiftConfigView from '../../components/views/ShiftConfigView.uvue'
	import LeaveApplyView from '../../components/views/LeaveApplyView.uvue'
	import LeaveApproveView from '../../components/views/LeaveApproveView.uvue'
	import MyApplicationsView from '../../components/views/MyApplicationsView.uvue'
	import TransferView from '../../components/views/TransferView.uvue'
	import UserChatView from '../../components/views/UserChatView.uvue'
	import { api } from '../../common/api.js'

	export default {
		components: {
			DashboardView,
			ScheduleView,
			ShiftConfigView,
			LeaveApplyView,
			LeaveApproveView,
			MyApplicationsView,
			TransferView,
			UserChatView
		},
		data() {
			return {
				currentTab: 'dashboard',
				currentDate: '',
				scrollTop: 0,
				lastScrollTop: 0,
				// 用户信息
				userName: '',
				realName: '',
				roleCode: '',
				roleName: '',
				heartbeatTimer: null as number | null
			}
		},
		computed: {
			currentPageTitle() {
				const map = {
					'dashboard': '工作台',
					'schedule': '排班管理',
					'shift': '班次配置',
					'leave_apply': '请假申请',
					'leave_approve': '请假审批',
					'my_applications': '我的申请',
					'transfer': '会话管理',
					'user_chat': '客服聊天'
				}
				return map[this.currentTab] || '未知页面'
			},
			// 用户头像（取姓名第一个字）
			userAvatar() {
				return this.realName ? this.realName.charAt(0) : 'U'
			},
			// 是否为管理员
			isAdmin() {
				return this.roleCode === 'admin'
			},
			// 是否为经理
			isManager() {
				return this.roleCode === 'manager'
			},
			// 是否为客服
			isCS() {
				return this.roleCode === 'customer_service' || this.roleCode === 'cs'
			},
			isUser() {
				return this.roleCode === 'user'
			}
		},
		onLoad() {
			// 检查登录状态
			const token = uni.getStorageSync('token')
			if (!token) {
				// 未登录，跳转到登录页
				uni.reLaunch({ url: '/pages/login/login' })
				return
			}

			// 加载用户信息
			try {
				const userInfoStr = uni.getStorageSync('userInfo')
				if (userInfoStr != null && userInfoStr != '') {
					let userInfo : UTSJSONObject | null = null
					if (typeof userInfoStr == 'string') {
						try {
							userInfo = JSON.parse(userInfoStr as string) as UTSJSONObject
						} catch (e) {
							console.error('JSON解析失败:', e)
						}
					} else {
						userInfo = userInfoStr as UTSJSONObject
					}

					if (userInfo != null) {
						this.userName = (userInfo['user_name'] ?? '') as string
						this.realName = (userInfo['real_name'] ?? '') as string
						this.roleCode = (userInfo['role_code'] ?? '') as string
						this.roleName = (userInfo['role_name'] ?? '') as string
					}
				}
			} catch (e) {
				console.error('读取用户信息失败:', e)
			}

			// 设置当前日期
			const d = new Date()
			this.currentDate = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
			
			// 开启心跳定时器（如果是客服或管理员）
			this.startHeartbeat()
			
			// 根据角色设置默认首页
			if (this.isAdmin) {
				this.currentTab = 'dashboard'
			} else if (this.isManager) {
				this.currentTab = 'schedule'
			} else if (this.isUser) {
				this.currentTab = 'user_chat'
			} else {
				this.currentTab = 'leave_apply'
			}
		},
		// 页面卸载时自动登出（确保客服状态正确更新）
		onUnload() {
			this.performLogout()
		},
		// 页面隐藏时（如切换到其他App）不自动登出，保持在线状态
		// onHide 不需要登出，因为用户可能只是临时切换
		mounted() {
			// #ifdef H5
			// Web端：监听浏览器关闭/刷新事件，确保登出
			window.addEventListener('beforeunload', this.handleBeforeUnload)
			// #endif
		},
		beforeDestroy() {
			// #ifdef H5
			// Web端：移除事件监听
			window.removeEventListener('beforeunload', this.handleBeforeUnload)
			// #endif
		},
		methods: {
			// 切换标签页（带权限检查）
			switchTab(tab) {
				// 定义每个角色允许访问的页面
				const rolePermissions = {
					'admin': ['dashboard', 'schedule', 'shift', 'leave_approve', 'transfer'],
					'manager': ['schedule', 'leave_approve'],
					'customer_service': ['schedule', 'leave_apply', 'my_applications', 'transfer'],
					'cs': ['schedule', 'leave_apply', 'my_applications', 'transfer'],
					'user': ['user_chat']
				}

				let allowedTabs = []
				if (this.isAdmin) {
					allowedTabs = rolePermissions.admin
				} else if (this.isManager) {
					allowedTabs = rolePermissions.manager
				} else if (this.isUser) {
					allowedTabs = rolePermissions.user
				} else {
					allowedTabs = rolePermissions.customer_service
				}

				if (!allowedTabs.includes(tab)) {
					uni.showToast({
						title: '无权限访问该页面',
						icon: 'none'
					})
					return
				}

				this.currentTab = tab
				this.scrollToTop()
			},
			scrollToTop() {
				// 先设为一个极小值或不同值触发响应
				this.scrollTop = this.lastScrollTop
				this.$nextTick(() => {
					this.scrollTop = 0
				})
			},
			onViewScroll(e) {
				this.lastScrollTop = e.detail.scrollTop
			},
			startHeartbeat() {
				// 只有客服和管理员需要发送心跳更新在线状态
				if (!this.isCS && !this.isAdmin) return
				
				const sendHeartbeat = () => {
					if (!this.userName) return
					const userInfoStr = uni.getStorageSync('userInfo')
					let csId = ''
					if (userInfoStr) {
						const userInfo = typeof userInfoStr === 'string' ? JSON.parse(userInfoStr) : userInfoStr
						const id = userInfo['id']
						if (id) {
							// 统一使用 cs{id} 格式，确保 parseCsId 能解析出正确的数字用于 WS 路由
							csId = `cs${id}`
						}
					}
					
					if (csId) {
						api.heartbeat(csId).then(res => {
							console.log('心跳同步成功:', csId)
						}).catch(err => {
							console.error('心跳同步失败:', err)
						})
					}
				}
				
				// 立即执行一次
				sendHeartbeat()
				// 每 30 秒执行一次
				this.heartbeatTimer = setInterval(sendHeartbeat, 30000)
			},
			stopHeartbeat() {
				if (this.heartbeatTimer != null) {
					clearInterval(this.heartbeatTimer)
					this.heartbeatTimer = null
				}
			},
			// 获取当前用户的cs_id（格式：cs+用户ID）
			getCurrentCsId() {
				try {
					const userInfo = uni.getStorageSync('userInfo')
					if (userInfo) {
						const info = typeof userInfo === 'string' ? JSON.parse(userInfo) : userInfo
						const id = info['id']
						if (id) {
							return `cs${id}`
						}
					}
				} catch (e) {
					console.error('获取csId失败:', e)
				}
				return ''
			},
			// 执行登出操作（停止心跳并调用登出接口）
			performLogout() {
				this.stopHeartbeat()
				const csId = this.getCurrentCsId()
				if (csId) {
					api.logout(csId)
				}
			},
			// #ifdef H5
			// 浏览器关闭/刷新事件处理
			handleBeforeUnload(event) {
				this.performLogout()
				// 某些浏览器需要这个来触发确认对话框，但我们这里不需要
				// event.preventDefault()
				// event.returnValue = ''
			},
			// #endif
			// 退出登录（用户点击退出按钮）
			handleLogout() {
				uni.showModal({
					title: '提示',
					content: '确定要退出登录吗？',
					success: (res) => {
						if (res.confirm) {
							// 执行登出操作（停止心跳并调用登出接口）
							this.performLogout()
							// 使用 reLaunch 跳转到登录页，避免页面栈问题
							uni.reLaunch({ url: '/pages/login/login' })
						}
					}
				})
			}
		}
	}
</script>

<style>
	.main-layout {
		flex-direction: row;
		width: 100%;
		height: 100vh;
		background-color: #f5f7fa;
		overflow: hidden; /* 防止整体滚动 */
	}

	/* Sidebar Styles */
	.sidebar {
		width: 240px;
		background-color: #ffffff;
		border-right: 1px solid #ebedf0;
		flex-direction: column;
		display: flex;
	}

	.sidebar-header {
		height: 64px;
		flex-direction: row;
		align-items: center;
		padding: 0 20px;
		border-bottom: 1px solid #f5f5f7;
	}

	.logo {
		width: 32px;
		height: 32px;
		margin-right: 10px;
	}

	.app-title {
		font-size: 18px;
		font-weight: 600;
		color: #1d1d1f;
	}

	.menu-scroll {
		flex: 1;
		padding: 16px 0;
	}

	.menu-group-title {
		padding: 0 24px;
		margin-top: 16px;
		margin-bottom: 8px;
		font-size: 12px;
		color: #86909c;
		font-weight: 500;
	}

	.menu-item {
		flex-direction: row;
		align-items: center;
		height: 48px;
		padding: 0 20px;
		margin: 0 12px;
		border-radius: 8px;
		cursor: pointer; /* PC style */
	}

	.menu-item:hover {
		background-color: #f7f8fa;
	}

	.menu-item.active {
		background-color: #e8f3ff;
	}

	.menu-item.active .menu-text {
		color: #007aff;
		font-weight: 500;
	}

	.menu-icon {
		font-size: 18px;
		margin-right: 12px;
	}

	.menu-text {
		font-size: 14px;
		color: #4e5969;
	}

	.sidebar-footer {
		min-height: 64px;
		border-top: 1px solid #f5f5f7;
		padding: 12px 20px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.user-info {
		flex-direction: row;
		align-items: center;
	}

	.avatar {
		width: 32px;
		height: 32px;
		border-radius: 16px;
		background-color: #007aff;
		justify-content: center;
		align-items: center;
		color: #fff;
		font-size: 14px;
		font-weight: 600;
		margin-right: 10px;
	}

	.username {
		font-size: 14px;
		color: #1d1d1f;
		font-weight: 500;
	}

	/* Content Area Styles */
	.content-area {
		flex: 1;
		flex-direction: column;
		display: flex;
		height: 100vh;
	}

	.top-bar {
		height: 64px;
		background-color: #ffffff;
		border-bottom: 1px solid #ebedf0;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 32px;
	}

	.page-title {
		font-size: 18px;
		font-weight: 600;
		color: #1d1d1f;
	}

	.date-display {
		font-size: 14px;
		color: #86909c;
	}

	.view-scroll {
		flex: 1;
		/* background-color: #f5f7fa; already set on main-layout but good to ensure */
	}

	.view-container {
		padding: 24px 32px;
		min-height: 100%;
	}

	/* 用户详情样式 */
	.user-detail {
		flex-direction: column;
		flex: 1;
	}

	.role-name {
		font-size: 12px;
		color: #86909c;
		margin-top: 2px;
	}

	/* 退出登录按钮样式 */
	.logout-btn {
		flex-direction: row;
		align-items: center;
		padding: 6px 12px;
		border-radius: 6px;
		cursor: pointer;
	}

	.logout-btn:hover {
		background-color: #fff1f0;
	}

	.logout-icon {
		font-size: 14px;
		margin-right: 4px;
	}

	.logout-text {
		font-size: 12px;
		color: #f5222d;
	}
</style>
