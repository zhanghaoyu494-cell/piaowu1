<template>
	<view class="user-chat-view">
		<text class="section-title">用户端客服聊天</text>

		<view class="card">
			<view class="chat-header">
				<view class="chat-header-main">
					<text class="chat-title">{{ csName ? ('正在与 ' + csName + ' 对话') : '正在分配客服...' }}</text>
					<text class="chat-sub">会话：{{ convId || '-' }}</text>
				</view>
				<view class="chat-header-actions">
					<button v-if="csId === 'CS9999'" class="apple-btn apple-btn-small apple-btn-warning" @click="transferToHuman" :disabled="loading">转人工</button>
					<button v-else-if="csId && csId !== 'CS9999'" class="apple-btn apple-btn-small apple-btn-warning" @click="transferToAI" :disabled="loading">转智能客服</button>
					<button class="apple-btn apple-btn-small" @click="refreshSession" :disabled="loading">刷新</button>
				</view>
			</view>

			<view class="chat-body">
				<scroll-view scroll-y="true" class="chat-list" :scroll-into-view="lastMsgId">
					<view v-if="messages.length === 0" class="empty-state">
						<text class="empty-text">{{ loading ? '加载中...' : '暂无消息' }}</text>
					</view>
					<view v-else>
						<view v-for="m in messages" :id="m._k" :key="m._k" class="msg-row" :class="{ mine: m.sender_type === 1 }">
							<text class="msg-meta">{{ m.send_time }}</text>
							<view class="msg-bubble">
								<text class="msg-text">{{ m.msg_content }}</text>
							</view>
						</view>
					</view>
				</scroll-view>

				<view class="chat-input">
					<input class="apple-input chat-text" v-model="inputText" placeholder="输入消息..." @confirm="sendText" />
					<button class="apple-btn apple-btn-small" @click="sendText" :disabled="!wsConnected">发送</button>
				</view>
				<view class="status-row">
					<text class="status-text">{{ wsConnected ? '实时连接已建立' : '未连接(将自动重连)' }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	import { api } from '../../common/api.js'
	import { ensureOk, getBaseUrl } from '../../common/request.js'

	export default {
		data() {
			return {
				loading: false,
				currentUserId: 0,
				currentUserName: '',
				convId: '',
				csId: '',
				csName: '',
				toUserId: 0,
				inputText: '',
				messages: [],
				wsConnected: false,
				wsSocket: null,
				reconnectTimer: null,
				lastMsgId: ''
			}
		},
		mounted() {
			this.bootstrap()
		},
		beforeUnmount() {
			this.cleanup()
		},
		methods: {
			bootstrap() {
				this.loadUserFromStorage()
				if (!this.currentUserId) {
					uni.showToast({ title: '未登录', icon: 'none' })
					return
				}
				this.refreshSession()
			},
			loadUserFromStorage() {
				try {
					const raw = uni.getStorageSync('userInfo')
					if (!raw) return
					const info = typeof raw === 'string' ? JSON.parse(raw) : raw
					this.currentUserId = Number(info.id || 0)
					this.currentUserName = String(info.real_name || info.user_name || '')
				} catch (e) {
					this.currentUserId = 0
				}
			},
			async refreshSession() {
				if (this.loading) return
				this.loading = true
				try {
					const res = await api.assignCustomer({
						user_id: String(this.currentUserId),
						user_nickname: this.currentUserName || String(this.currentUserId),
						source: 'Web'
					})
					ensureOk(res)
					this.convId = res.conv_id || ''
					this.csId = res.cs_id || ''
					this.csName = res.cs_name || this.csId || ''
					this.toUserId = this.parseCsUserId(this.csId)

					await this.reloadMessages()
					this.connectWebSocket()
				} catch (e) {
					this.convId = ''
					this.csId = ''
					this.csName = ''
					this.toUserId = 0
					this.messages = []
					console.error('Assign customer failed:', e);
					uni.showToast({ title: '分配客服: ' + (e.message || '未知错误'), icon: 'none' });
				} finally {
					this.loading = false;
				}
			},
			async transferToHuman() {
				if (this.loading) return
				uni.showModal({
					title: '提示',
					content: '是否转接到人工客服？',
					success: async (sm) => {
						if (!sm.confirm) return
						this.loading = true
						try {
							const res = await api.assignCustomer({
								user_id: String(this.currentUserId),
								user_nickname: this.currentUserName || String(this.currentUserId),
								source: 'TRANSFER_FROM_AI'
							})
							ensureOk(res)
							this.convId = res.conv_id || ''
							this.csId = res.cs_id || ''
							this.csName = res.cs_name || this.csId || ''
							this.toUserId = this.parseCsUserId(this.csId)

							uni.showToast({ title: '已成功转接人工', icon: 'success' })
							await this.reloadMessages()
						} catch (e) {
							uni.showToast({ title: '转接人工失败，请稍后重试', icon: 'none' })
						} finally {
							this.loading = false
						}
					}
				})
			},
			async transferToAI() {
				if (this.loading) return
				uni.showModal({
					title: '提示',
					content: '是否转回智能客服？',
					success: async (sm) => {
						if (!sm.confirm) return
						this.loading = true
						try {
							const res = await api.assignCustomer({
								user_id: String(this.currentUserId),
								user_nickname: this.currentUserName || String(this.currentUserId),
								source: 'TRANSFER_TO_AI'
							})
							ensureOk(res)
							this.convId = res.conv_id || ''
							this.csId = res.cs_id || ''
							this.csName = res.cs_name || this.csId || ''
							this.toUserId = this.parseCsUserId(this.csId)

							uni.showToast({ title: '已成功转接智能客服', icon: 'success' })
							await this.reloadMessages()
						} catch (e) {
							uni.showToast({ title: '转接状态失败，请稍后重试', icon: 'none' })
						} finally {
							this.loading = false
						}
					}
				})
			},
			parseCsUserId(csId) {
				const s = String(csId || '').trim()
				if (!s) return 0
				// 尝试匹配纯数字 (如 "5")
				const m1 = s.match(/^(\d+)$/)
				if (m1) return Number(m1[0])
				// 兼容原来的 "cs123" 或 "CS123" 格式
				const m2 = s.match(/^cs(\d+)$/i)
				if (m2) return Number(m2[1])
				return 0
			},
			async reloadMessages() {
				if (!this.convId) return
				const res = await api.listConversationMessage({
					conv_id: this.convId,
					page: 1,
					page_size: 1000,
					order_asc: 1
				})
				ensureOk(res)
				const items = res.messages || []
				this.messages = items.map((x) => {
					return {
						_k: String(x.msg_id || '') + '_' + String(x.send_time || ''),
						msg_content: x.msg_content || '',
						send_time: x.send_time || '',
						sender_type: x.sender_type === 1 ? 1 : 0
					}
				})
			},
			connectWebSocket() {
				const token = uni.getStorageSync('token')
				if (!token) return

				this.closeWebSocket()

				const baseUrl = getBaseUrl()
				const wsBase = baseUrl.replace('http', 'ws')
				const wsUrl = wsBase + '/ws?token=' + encodeURIComponent(String(token))
				const task = uni.connectSocket({ url: wsUrl })
				this.wsSocket = task

				// 兼容性监听函数封装
				const bindEvent = (event, callback) => {
					const methodName = 'on' + event.charAt(0).toUpperCase() + event.slice(1)
					if (task && typeof task[methodName] === 'function') {
						task[methodName](callback)
					} else {
						// 回退到全局监听（注意控制全局状态同步）
						const globalMethodName = 'onSocket' + event.charAt(0).toUpperCase() + event.slice(1)
						if (typeof uni[globalMethodName] === 'function') {
							uni[globalMethodName](callback)
						}
					}
				}

				if (task) {
					bindEvent('open', () => {
						console.log('User WebSocket Connected')
						this.wsConnected = true
					})
					bindEvent('message', (res) => {
						this.handleWsData(res.data)
					})
					bindEvent('error', (err) => {
						console.error('User WebSocket Error:', err)
						this.wsConnected = false
						this.scheduleReconnect()
					})
					bindEvent('close', () => {
						console.log('User WebSocket Closed')
						this.wsConnected = false
						this.scheduleReconnect()
					})
				}
			},
			scheduleReconnect() {
				if (this.reconnectTimer) return
				this.reconnectTimer = setTimeout(() => {
					this.reconnectTimer = null
					if (!this.wsConnected) this.connectWebSocket()
				}, 3000)
			},
			closeWebSocket() {
				if (this.wsSocket) {
					try {
						if (typeof this.wsSocket.close === 'function') {
							this.wsSocket.close({})
						} else {
							uni.closeSocket()
						}
					} catch (e) { }
				}
				this.wsSocket = null
				this.wsConnected = false
			},
			handleWsData(data) {
				const text = typeof data === 'string' ? data : ''
				if (!text) return
				const parts = text.split('\n').filter((x) => x && x.trim())
				for (let i = 0; i < parts.length; i++) {
					this.handleWsMessage(parts[i])
				}
			},
			handleWsMessage(raw) {
				try {
					const msg = JSON.parse(raw)
					if (msg.type !== 'chat' || !msg.payload) return
					const p = msg.payload
					if (String(p.conversation_id || '') !== String(this.convId || '')) return
					const mine = Number(p.from_user_id || 0) === Number(this.currentUserId || 0)
					const newMsgId = 'msg_' + String(Date.now()) + '_' + String(Math.random())
					this.messages.push({
						_k: newMsgId,
						msg_content: String(p.content || ''),
						send_time: String(p.create_time || ''),
						sender_type: mine ? 1 : 0
					})
					// 自动滚动到底部
					this.$nextTick(() => {
						this.lastMsgId = newMsgId
					})
				} catch (e) { }
			},
			sendText() {
				const text = (this.inputText || '').trim()
				if (!text) return
				if (!this.convId || !this.toUserId) {
					uni.showToast({ title: '会话未就绪', icon: 'none' })
					return
				}
				if (!this.wsConnected) {
					uni.showToast({ title: '未连接，稍后重试', icon: 'none' })
					return
				}
				const msg = {
					type: 'chat',
					payload: {
						conversation_id: this.convId,
						content: text,
						msg_type: 0,
						to_user_id: this.toUserId
					}
				}
				const payload = JSON.stringify(msg)
				try {
					if (this.wsSocket && typeof this.wsSocket.send === 'function') {
						this.wsSocket.send({
							data: payload,
							success: () => {
								this.inputText = ''
							}
						})
					} else {
						uni.sendSocketMessage({
							data: payload,
							success: () => {
								this.inputText = ''
							}
						})
					}
				} catch (e) { }
			},
			cleanup() {
				if (this.reconnectTimer) {
					clearTimeout(this.reconnectTimer)
					this.reconnectTimer = null
				}
				this.closeWebSocket()
			}
		}
	}
</script>

<style>
	.user-chat-view {
		padding: 20px;
	}
	.section-title {
		font-size: 18px;
		font-weight: 600;
		color: #1d1d1f;
		margin-bottom: 16px;
		display: block;
	}
	.card {
		background: #ffffff;
		border: 1px solid #ebedf0;
		border-radius: 12px;
		padding: 16px;
	}
	.chat-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}
	.chat-title {
		font-size: 15px;
		font-weight: 600;
		color: #1d1d1f;
		display: block;
	}
	.chat-sub {
		font-size: 12px;
		color: #86909c;
		margin-top: 4px;
		display: block;
	}
	.chat-body {
		display: flex;
		flex-direction: column;
	}
	.chat-list {
		height: 420px;
		border: 1px solid #f0f0f0;
		border-radius: 10px;
		padding: 12px;
		background: #fafafa;
	}
	.msg-row {
		margin-bottom: 10px;
		align-items: flex-start;
	}
	.msg-row.mine {
		align-items: flex-end;
	}
	.msg-meta {
		font-size: 11px;
		color: #86909c;
		margin-bottom: 4px;
	}
	.msg-bubble {
		max-width: 80%;
		padding: 10px 12px;
		border-radius: 12px;
		background: #ffffff;
		border: 1px solid #ebedf0;
	}
	.msg-row.mine .msg-bubble {
		background: #e8f3ff;
		border-color: #cfe6ff;
	}
	.msg-text {
		font-size: 14px;
		color: #1d1d1f;
	}
	.chat-input {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
	}
	.chat-text {
		flex: 1;
		margin-right: 10px;
	}
	.status-row {
		margin-top: 10px;
	}
	.status-text {
		font-size: 12px;
		color: #86909c;
	}
	.empty-state {
		padding: 24px 0;
		align-items: center;
		justify-content: center;
	}
	.empty-text {
		font-size: 12px;
		color: #86909c;
	}
	.apple-btn-warning {
		background: #ff9500 !important;
		border-color: #ff9500 !important;
		margin-right: 8px;
	}
	.chat-header-actions {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
</style>
