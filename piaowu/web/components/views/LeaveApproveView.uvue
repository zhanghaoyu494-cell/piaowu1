		margin-top: 4px;
		flex-shrink: 0;
	}

	.dot-default {
		background-color: #86868b;
	}

	.dot-success {
		background-color: #34c759;
		box-shadow: 0 0 0 4px rgba(52, 199, 89, 0.1);
	}

	.dot-error {
		background-color: #ff3b30;
		box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
	}

