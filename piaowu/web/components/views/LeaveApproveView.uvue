	.approve-btn.pass.selected {
		background-color: #e8f9ec;
		border-color: #34c759;
		font-weight: 600;
	}

	.approve-btn.reject {
		background-color: #f5f5f7;
		color: #ff3b30;
	}

	.approve-btn.reject.selected {
		background-color: #ffebe9;
		border-color: #ff3b30;
		font-weight: 600;
	}
</style>
