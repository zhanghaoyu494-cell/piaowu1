	}

	.empty-state {
		margin-top: 20px;
		align-items: center;
		justify-content: center;
	}

	.empty-text {
		color: #86868b;
		font-size: 13px;
	}

	.field {
		margin-bottom: 14px;
	}

	.approve-actions {
		flex-direction: row;
