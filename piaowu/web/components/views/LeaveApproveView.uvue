		box-shadow: 0 0 0 4px rgba(255, 204, 0, 0.1);
	}

	.audit-content {
		flex: 1;
		background-color: #f8f9fa;
		border-radius: 8px;
		padding: 10px;
	}

	.audit-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 6px;
	}

	.audit-action {
		font-size: 14px;
